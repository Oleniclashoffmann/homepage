---
import Base from '../../layouts/Base.astro';
import BracketLinks from '../../components/BracketLinks.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
---
<Base title={p.data.title} description={p.data.summary}>
  <div class="article">
    <a class="back" href="/">← Back to Home</a>
    <h1>{p.data.title}</h1>
    <p class="date">{p.data.date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })} · {p.data.tags.join(' · ')}</p>
    <div class="callout">{p.data.summary}</div>
    {Object.keys(p.data.links).length > 0 && <BracketLinks links={p.data.links} />}
    <article class="prose"><Content /></article>
  </div>
</Base>
