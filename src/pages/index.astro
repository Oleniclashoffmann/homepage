---
import Base from '../layouts/Base.astro';
import BracketLinks from '../components/BracketLinks.astro';
import { getCollection } from 'astro:content';
import { profile, publications } from '../data/profile';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Posts, newest first.
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base>
  <div class="intro">
    <img class="profile-image" src={profile.photo} alt={profile.name} width="112" height="112" />
    <h1>{profile.name}</h1>
    <p>{profile.about}</p>
    <BracketLinks links={profile.links} />
  </div>

  {publications.length > 0 && (
    <section>
      <h2>Papers</h2>
      <div class="paper-list">
        {publications.map((p) => (
          <a class="paper" href={p.href} target="_blank" rel="noopener noreferrer">
            {p.image && <img class="paper-teaser" src={p.image} alt={`Teaser figure: ${p.title}`} loading="lazy" />}
            <div>
              <h3>{p.title}</h3>
              <p class="meta">{p.authors}{p.status && <span class="paper-status">({p.status})</span>}</p>
              {p.blurb && <p class="desc">{p.blurb}</p>}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {projects.length > 0 && (
    <section>
      <h2>Projects</h2>
      <div class="entry-list">
        {projects.map((p) => (
          <a class="entry" href={`/projects/${p.id}/`}>
            <h3>{p.data.title}</h3>
            <p class="desc">{p.data.summary}</p>
            <span class="meta">{p.data.tags.join(' · ')}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {posts.length > 0 && (
    <section>
      <h2>Posts</h2>
      <div class="entry-list">
        {posts.map((p) => (
          <a class="entry" href={`/blog/${p.id}/`}>
            <h3>{p.data.title}</h3>
            <p class="desc">{p.data.description}</p>
            <span class="meta">{p.data.date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

