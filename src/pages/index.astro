---
import Base from '../layouts/Base.astro';
import BracketLinks from '../components/BracketLinks.astro';
import Timeline from '../components/Timeline.astro';
import { getCollection } from 'astro:content';
import { profile, educationTimeline, industryTimeline, publications } from '../data/profile';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Posts grouped by month, newest first.
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const months = new Map<string, typeof posts>();
for (const p of posts) {
  const key = p.data.date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
  months.set(key, [...(months.get(key) ?? []), p]);
}
---
<Base>
  <div class="intro">
    <header class="who">
      <h1>{profile.name}</h1>
      <p>{profile.location}</p>
    </header>
    <div class="about">
      <h2>About Me</h2>
      <p>{profile.about}</p>
      <BracketLinks links={profile.links} />
    </div>
  </div>

  <section>
    <h2>Education</h2>
    <Timeline entries={educationTimeline} />
  </section>

  <section>
    <h2>Industry</h2>
    <Timeline entries={industryTimeline} />
  </section>

  {publications.length > 0 && (
    <section>
      <h2>Papers / Preprints</h2>
      <div class="paper-list">
        {publications.map((p) => (
          <a class:list={['row', { 'paper-with-image': p.image }]} href={p.href} target="_blank" rel="noopener noreferrer">
            {p.image && <img class="paper-teaser" src={p.image} alt={`Teaser figure: ${p.title}`} loading="lazy" />}
            <div>
              <h3>{p.title}</h3>
              <p class="meta">{p.authors}</p>
              {p.blurb && <p class="desc">{p.blurb}</p>}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {projects.length > 0 && (
    <section>
      <h2>Projects</h2>
      <div class="box green">
        {projects.map((p) => (
          <a class="row" href={`/projects/${p.id}/`}>
            <h3>{p.data.title}</h3>
            <p class="meta">{p.data.tags.join(' · ')}</p>
            <p class="desc">{p.data.summary}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {posts.length > 0 && (
    <section>
      <h2>Posts</h2>
      <div class="box peach">
        {[...months].map(([month, list]) => (
          <>
            <div class="month">{month}</div>
            {list.map((p) => (
              <a class="row" href={`/blog/${p.id}/`}>
                <h3>{p.data.title}</h3>
                <p class="desc">{p.data.description}</p>
              </a>
            ))}
          </>
        ))}
      </div>
    </section>
  )}
</Base>

