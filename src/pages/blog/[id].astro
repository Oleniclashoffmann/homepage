---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
---
<Base title={p.data.title} description={p.data.description}>
  <div class="article">
    <a class="back" href="/">← Back to Home</a>
    <h1>{p.data.title}</h1>
    <p class="date">{p.data.date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}</p>
    <div class="callout">{p.data.description}</div>
    <article class="prose"><Content /></article>
  </div>
</Base>
